<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Encryption Secret (optional on server)" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/txtSmsSecret"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Passphrase or b64:... key"
            android:inputType="text" />

        <Button
            android:id="@+id/btnSmsGenSecret"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Generate" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/chkSmsShareSecret"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="false"
        android:text="Share secret with server (off by default)" />
</LinearLayout>
